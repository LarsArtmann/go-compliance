package dashboard

import (
	"strconv"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/icons"
)

// StatCards renders the fleet summary strip. The patch stream re-renders
// this whole region on refreshes, so the cards need no signal bindings.
templ StatCards(counts map[string]int, total int) {
	@display.Grid(display.GridProps{Cols: display.GridCols4}) {
		@display.StatCard(display.StatCardProps{
			Value: strconv.Itoa(total),
			Label: "Total repos",
			Tone:  display.StatToneBlue,
			Icon:  icons.Server,
		})
		@display.StatCard(display.StatCardProps{
			Value: strconv.Itoa(counts["failing"]),
			Label: "Failing",
			Tone:  display.StatToneRed,
			Icon:  icons.ExclamationTriangle,
		})
		@display.StatCard(display.StatCardProps{
			Value: strconv.Itoa(counts["stale"]),
			Label: "Stale",
			Tone:  display.StatToneYellow,
			Icon:  icons.Clock,
		})
		@display.StatCard(display.StatCardProps{
			Value: strconv.Itoa(counts["never-covered"]),
			Label: "Never covered",
			Tone:  display.StatTonePurple,
			Icon:  icons.Search,
		})
	}
}
