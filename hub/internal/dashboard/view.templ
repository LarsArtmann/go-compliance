package dashboard

import (
	"fmt"
	"time"

	"github.com/larsartmann/templ-components/datastar"
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/layout"
	"github.com/larsartmann/templ-components/utils"

	"github.com/larsartmann/go-compliance/hub/internal/events"
)

// View renders the full fleet compliance page: Base shell (no HTMX —
// DataStar owns realtime), the fleet summary whose chips filter the table,
// and a LiveRegion whose stream patches the summary and the fleet table.
templ View(model ViewModel) {
	@layout.Base(layout.PageProps{
		Title:       model.Title,
		CSSPath:     model.CSSSrc,
		HTMXVersion: "",
		Favicon:     faviconRoute,
		BodyClass:   pageBodyClass,
		HeadContent: headContent(model),
	}) {
		@layout.Container(layout.DefaultContainerProps()) {
			<div class="py-8">
				@display.PageHeader(display.PageHeaderProps{
					Title:  model.Title,
					Action: pageStatus(model.RenderedAt),
				})
				<div data-signals={ filterSignalsJSON(model.Counts, model.Total, model.StateFilter) }>
					<div id={ FleetSummaryID }>
						@FleetSummary(model.Counts, model.Total, model.StateFilter)
					</div>
				</div>
				<div class="mt-6">
					@datastar.LiveRegion(datastar.LiveRegionProps{
						BaseProps: utils.BaseProps{ID: FleetRegionID},
						URL:       model.StreamURL,
						AutoStart: true,
						// The region wraps a 200-row table: a live region would
						// announce every patched row to assistive technology.
						// The headline and the freshness line carry the story.
						Live: datastar.LiveOff,
						// A hub restart ends the SSE stream with a clean EOF;
						// RetryAlways reconnects across restarts (the failure
						// counter resets on every successful connect).
						Retry: datastar.RetryAlways,
					}) {
						@fleetTable(model.Rows, model.StateFilter)
					}
				</div>
			</div>
		}
	}
}

// pageStatus sits at the right of the title: the one AutoRefresh=true
// RelativeTime on the page and the theme toggle. It ships the singleton 30s
// tick script that keeps every data-tc-relative cell (rows included)
// honest, and its own text going stale is the dead-stream signal. It stays
// outside every patched region, so the script is never re-sent.
templ pageStatus(renderedAt time.Time) {
	<div class="flex items-center gap-3">
		<span
			id={ renderedStatusID }
			class="flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400"
		>
			<span>rendered</span>
			@display.RelativeTime(display.RelativeTimeProps{
				BaseProps:   utils.BaseProps{Class: "text-xs"},
				Time:       renderedAt,
				AutoRefresh: true,
			})
		</span>
		@layout.ThemeToggle("Toggle dark mode", "")
	</div>
}

// headContent loads the DataStar SDK (self-hosted when ScriptSrc is set).
// The pre-paint theme script and the stylesheet link come from Base
// (PageProps.CSSPath); the Play CDN and its inline tailwind.config block are
// gone (CSP debt paid, 2026-11-19).
templ headContent(model ViewModel) {
	if model.ScriptSrc != "" {
		@datastar.SDKScript(datastar.SDKScriptProps{
			BaseProps: utils.BaseProps{},
			Src:       model.ScriptSrc,
		})
	} else {
		@datastar.SDKScript(datastar.SDKScriptProps{BaseProps: utils.BaseProps{}})
	}
}

// fleetTable renders the fleet table with the patchable tbody: the stream
// targets the BodyID region (inner mode) and individual rows via their
// data-repo selectors. The fleet-table container lets the stylesheet stack
// the rows once the table gets narrower than its columns. A selection that
// holds no repo hides the table and says so; the table stays in the DOM
// because the stream patches its body.
templ fleetTable(rows []events.RepoRow, selected string) {
	<div class="@container">
		<div
			data-show={ tableShowExpression }
			if len(rows) == 0 && selected != "all" && selected != "unknown" {
				style="display:none"
			}
		>
			@display.Table(display.TableProps{
				BaseProps: utils.BaseProps{
					Class:     fleetTableClass,
					AriaLabel: "Fleet compliance by repository",
				},
				Headers:     []string{"Repo", "State", "Findings", "Last run"},
				Hover:       true,
				// The header row pins to the top of the table's scroll box
				// (app.css gives that box its height in wide layouts).
				StickyHeader: true,
				CellPadding: display.TableCellPaddingCompact,
				LazyRows:    true,
				BodyID:      DefaultRowsSelector[1:],
				Body:        fleetRowsBody(rows),
			})
		</div>
		for _, chip := range filterChips {
			if chip.State != "all" {
				<div
					data-show={ fmt.Sprintf("$stateFilter==='%s' && !$counts['%s']", chip.State, chip.State) }
					if !(len(rows) == 0 && chip.State == selected) {
						style="display:none"
					}
				>
					@display.SimpleEmptyState(chip.Empty)
				</div>
			}
		}
	</div>
}

// tableShowExpression keeps the table visible while the selection holds a
// repo (or selects nothing specific); a missing count reads as zero.
const tableShowExpression = "$stateFilter==='all' || $stateFilter==='unknown' || $counts[$stateFilter] > 0"

templ fleetRowsBody(rows []events.RepoRow) {
	@FleetRows(rows)
	if len(rows) == 0 {
		<tr>
			<td colspan="4">
				@display.SimpleEmptyState("No compliance evidence yet. The first refresh publishes it here.")
			</td>
		</tr>
	}
}
