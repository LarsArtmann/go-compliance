package dashboard

import (
	"fmt"

	"github.com/larsartmann/templ-components/utils"
)

// filterChip is the chip model: the signal value it selects, its label, and
// what the table says when the selection holds no repo.
type filterChip struct {
	State string
	Label string
	Empty string
}

// filterChips is ordered worst-first to mirror the table ordering.
var filterChips = []filterChip{
	{State: "all", Label: "All"},
	{State: "failing", Label: "Failing", Empty: "No failing repos"},
	{State: "stale", Label: "Stale", Empty: "No stale repos"},
	{State: "never-covered", Label: "Never covered", Empty: "No never-covered repos"},
	{State: "compliant", Label: "Compliant", Empty: "No compliant repos"},
}

// StateFilterChips renders the state filter as zero-navigation buttons: each
// sets the stateFilter signal, and every fleet row's data-show expression
// reacts instantly. The chips double as the legend: each carries the count
// it selects. No-JS clients filter via the ?state= query parameter on the
// page URL instead.
templ StateFilterChips(selected string, counts map[string]int, total int) {
	<div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by state">
		for _, chip := range filterChips {
			<button
				type="button"
				data-on:click={ fmt.Sprintf("$stateFilter='%s'", chip.State) }
				data-class={ chipClassExpression(chip.State) }
				data-attr:aria-pressed={ fmt.Sprintf("$stateFilter==='%s' ? 'true' : 'false'", chip.State) }
				class={ chipBaseClass, utils.Ternary(chip.State == selected, chipSelectedClass, chipUnselectedClass) }
				aria-pressed={ fmt.Sprintf("%t", chip.State == selected) }
			>
				{ chip.Label }
				<span class="ms-1.5 tabular-nums font-normal">{ fmt.Sprintf("%d", chipCount(chip.State, counts, total)) }</span>
			</button>
		}
	</div>
}

// chipClassExpression swaps a chip between its selected and unselected
// looks as the filter signal changes. DataStar's class action expects an
// object of class names to booleans; a plain class string would be iterated
// character by character.
func chipClassExpression(state string) string {
	return fmt.Sprintf("{ '%s': $stateFilter==='%s', '%s': $stateFilter!=='%s' }",
		chipSelectedClass, state, chipUnselectedClass, state)
}

const (
	chipBaseClass       = "min-h-8 rounded-full border px-3 py-1 text-xs font-medium transition-colors"
	chipSelectedClass   = "border-accent-600 bg-accent-50 text-accent-700 dark:border-accent-400 dark:bg-accent-950/60 dark:text-accent-300"
	chipUnselectedClass = "border-gray-200 bg-white text-gray-600 hover:border-gray-300 hover:text-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400 dark:hover:border-gray-600 dark:hover:text-gray-200"
)
