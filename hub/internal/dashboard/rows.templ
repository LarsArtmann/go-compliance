package dashboard

import (
	"fmt"

	"github.com/dustin/go-humanize/english"
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/utils"

	"github.com/larsartmann/go-compliance"
	"github.com/larsartmann/go-compliance/hub/internal/events"
)

// FleetRows renders the table body content for a set of rows. It is patched
// into the rows region (inner mode) on snapshots and appended to (append
// mode) when refreshes add repos.
templ FleetRows(rows []events.RepoRow) {
	for _, row := range rows {
		@FleetRow(row)
	}
}

// FleetRow renders one fleet table row. The data-repo attribute is the
// per-row patch target: state changes replace this row, disappearances
// remove it.
templ FleetRow(row events.RepoRow) {
	<tr data-repo={ row.Repo } data-show={ fmt.Sprintf("$stateFilter==='all' || $stateFilter==='%s'", row.State) }>
		<td class={ cellClass }>{ row.Repo }</td>
		<td class={ cellClass }>@StateBadge(row.State)</td>
		<td class={ cellClass + " tabular-nums" }>@findingsCell(row)</td>
		<td class={ utils.Class(cellClass, lastRunCellClass(row)) }>
			// RelativeTime defaults to AutoRefresh false here ON PURPOSE: the
			// component couples that flag to emitting a per-instance <script>,
			// and rows re-render inside every DataStar patch. The
			// data-tc-relative attribute alone opts these cells into the
			// page-level script's 30s tick (see View), so the server-rendered
			// "3m ago" text stays honest without shipping N scripts per patch.
			// The text itself is computed at render time — patches with
			// identical row data can differ in this cell — but row diffing is
			// data-driven, so clock drift never triggers spurious patches.
			@display.RelativeTime(display.RelativeTimeProps{
				Time:      row.LastRunAt,
				EmptyText: "never",
				Attrs:     templ.Attributes{"data-tc-relative": true},
			})
			if len(row.WorstSteps) > 0 {
				<details class="mt-1 text-xs">
					<summary class="cursor-pointer select-none text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
						{ fmt.Sprintf("%d %s", len(row.WorstSteps), english.PluralWord(len(row.WorstSteps), "worst step", "worst steps")) }
					</summary>
					<ul class="mt-1 list-inside list-disc space-y-0.5 text-left">
						for _, step := range row.WorstSteps {
							<li>{ step }</li>
						}
					</ul>
				</details>
			}
		</td>
	</tr>
}

// cellClass is the fleet row cell padding: one step tighter than the
// header, so a 200-row fleet stays scannable without cramped text.
const cellClass = "px-4 py-1.5"

// lastRunCellClass marks a last-run cell that also lists its worst steps:
// the stacked narrow layout gives such a cell its own line.
func lastRunCellClass(row events.RepoRow) string {
	if len(row.WorstSteps) > 0 {
		return "fleet-has-steps"
	}

	return ""
}

// StateBadge maps a compliance state onto its semantic badge.
templ StateBadge(state compliance.State) {
	{{ badgeType := display.BadgeNeutral }}
	{{
		switch state {
		case compliance.StateFailing:
			badgeType = display.BadgeError
		case compliance.StateStale:
			badgeType = display.BadgeWarning
		case compliance.StateCompliant:
			badgeType = display.BadgeSuccess
		}
	}}
	@display.Badge(display.BadgeProps{
		Text: state.String(),
		Type: badgeType,
		Dot:  true,
	})
}

// findingsCell renders what a row was flagged for. The severity breakdown
// wins when the source carries one (the hub cache); file-backed evidence
// arrives without it, because the frozen v1 wire has no severity field, and
// falls back to the gate-findings count. A failing row must never read as
// "no findings".
templ findingsCell(row events.RepoRow) {
	if len(row.Severities) > 0 {
		@severityCells(row.Severities)
	} else if row.Findings > 0 {
		<span class="text-gray-600 dark:text-gray-300">{ findingsLabel(row.Findings) }</span>
	} else {
		<span class="text-gray-500 dark:text-gray-400">—</span>
	}
}

// severityCells renders the latest run's severity counts inline: errors
// red, warnings amber, the rest muted. Every token leads with its count,
// like the findings fallback, so the column reads as magnitudes. The order
// is canonical (ERR, WARN, INFO, then unknowns) so renders are
// deterministic; callers handle the empty case.
templ severityCells(severities map[string]int) {
	for _, severity := range sortedSeverities(severities) {
		{{ count := severities[severity] }}
		{{ tone := severityTone(severity) }}
		<span class={ fmt.Sprintf("mr-3 %s", tone) }>
			{ fmt.Sprintf("%d %s", count, severityLabel(severity)) }
		</span>
	}
}
